FROM docker.m.daocloud.io/debian:bookworm
ARG DEBIAN_FRONTEND=noninteractive

# replace the source list
RUN cp /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list.d/debian.sources.bak && \
     sed -i 's|http://deb.debian.org/debian|http://mirrors.tuna.tsinghua.edu.cn/debian|g' /etc/apt/sources.list.d/debian.sources && \
     sed -i 's|http://security.debian.org/debian-security|http://mirrors.tuna.tsinghua.edu.cn/debian|g' /etc/apt/sources.list.d/debian.sources
RUN set -eux; cat /etc/apt/sources.list.d/debian.sources

RUN set -eux; dpkg --add-architecture arm64
RUN set -eux; apt-get update && apt-get upgrade --yes
RUN set -eux; apt-get install --yes net-tools libatomic1 curl gdb cmake build-essential git zip rsync
RUN set -eux; apt-get install --yes gcc-aarch64-linux-gnu g++-aarch64-linux-gnu
RUN set -eux; apt-get install --yes --no-install-recommends \
      zlib1g:arm64 \
      libbz2-1.0:arm64 \
      liblzma5:arm64 \
      liblz4-1:arm64 \
      libzstd1:arm64 \
      libssl3:arm64 \
      libxml2:arm64 \
      libacl1:arm64 \
      libcap2:arm64

RUN set -eux; aarch64-linux-gnu-gcc --version
RUN set -eux; SYSROOT="$(aarch64-linux-gnu-gcc -print-sysroot)" && \
    echo "sysroot=$SYSROOT";printf '#include <features.h>\n' \
  | aarch64-linux-gnu-gcc --sysroot="$SYSROOT" -E -dM -x c - \
  | grep -E '__GLIBC__|__GLIBC_MINOR__'

RUN curl --location --output /usr/bin/release-cli "https://gitlab.com/api/v4/projects/gitlab-org%2Frelease-cli/packages/generic/release-cli/latest/release-cli-linux-amd64"
RUN chmod +x /usr/bin/release-cli

# install gcovr 8.2.tar.gz
COPY 8.2.tar.gz /tmp/
RUN set -eux; apt-get update && apt-get upgrade --yes && apt-get install --yes python3-pip python3-venv samba-client
RUN set -eux; python3 -m venv /opt/venv && /opt/venv/bin/pip install --upgrade pip && /opt/venv/bin/pip install /tmp/8.2.tar.gz
RUN set -eux; /opt/venv/bin/pip install PyYAML

# install sccache
COPY sccache /usr/bin/sccache
RUN chmod +x /usr/bin/sccache
RUN sccache --version
